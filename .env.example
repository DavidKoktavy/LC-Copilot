# Everything runs offline by default (no keys). Uncomment to use Azure.

# LC_LLM_PROVIDER=azure_openai
# LC_AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# LC_AZURE_OPENAI_API_KEY=
# LC_AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
# LC_AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# LC_VECTOR_BACKEND=azure_ai_search
# LC_AZURE_SEARCH_ENDPOINT=https://<service>.search.windows.net
# LC_AZURE_SEARCH_API_KEY=
# LC_AZURE_SEARCH_INDEX=lc-copilot

# PDFs / scans → Markdown via Document Intelligence (prebuilt-layout)
# LC_AZURE_DOCINTEL_ENDPOINT=https://<resource>.cognitiveservices.azure.com
# LC_AZURE_DOCINTEL_API_KEY=

# Input screening via Azure AI Content Safety
# LC_AZURE_CONTENT_SAFETY_ENDPOINT=https://<resource>.cognitiveservices.azure.com
# LC_AZURE_CONTENT_SAFETY_API_KEY=

# Or plain OpenAI
# LC_LLM_PROVIDER=openai
# LC_OPENAI_API_KEY=

# Tracing to Langfuse / LangSmith / Datadog via OTLP (pip install .[otel])
# LC_OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 pk:sk>

# MCP server least-privilege scopes: docs:read, data:read, notices:write
# LC_MCP_SCOPES=docs:read,data:read
